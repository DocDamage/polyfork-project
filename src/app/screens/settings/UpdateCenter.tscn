[node name="Subtitle" type="Label" parent="Header/TitleStack"]
layout_mode = 2
theme_type_variation = &"SecondaryLabel"
text = "Signed releases, safe replacement, rollback, diagnostics, and offline-first operation."
autowrap_mode = 2

[node name="VersionLabel" type="Label" parent="Header"]
