; Engine configuration file.
; PlayWorld Studio release candidate configuration.
config_version=5

[application]
config/name="PlayWorld Studio"
config/description="Create, author, play, and export interactive 3D worlds."
config/version="0.1.0-rc.1"
config/icon="res://assets/branding/playworld-studio-icon.svg"
run/main_scene="res://src/main/Main.tscn"

[autoload]
CreatorRuntimeConfig="*res://src/app/creator_runtime_config.gd"
ScalePolish="*res://src/scale/scale_polish_service.gd"
ExportWorkspace="*res://src/app/workspace/export_workspace_layer.gd"
NetworkRuntime="*res://src/network/network_runtime_service.gd"
MultiplayerWorkspace="*res://src/app/workspace/multiplayer_workspace_layer.gd"
ReleaseVerification="*res://src/release/release_verification.gd"
ReleaseAcceptance="*res://src/release/release_acceptance.gd"

[display]
window/size/viewport_width=1600
window/size/viewport_height=900
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"

[playworld]
product/company_name="PlayWorld Studio"
release/channel="rc"
release/source_commit="37d311b90f0684668a49e7f3b8ab197e6abcbe3a"
release/godot_version="4.7.1"
release/architecture="x86_64"
release/package_prefix="PlayWorld-Studio"
